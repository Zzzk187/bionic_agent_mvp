{
  "name": "@local/bionic-agent-panel",
  "version": "0.1.0",
  "private": true,
  "description": "把 bionic-agent 管理面板（FastAPI 8899）以 iframe 形式嵌入 DeepSeek Harness 侧边栏。",
  "icon": "assets/panel-icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-rc.3",
    "react": "^18.2.0"
  }
}
